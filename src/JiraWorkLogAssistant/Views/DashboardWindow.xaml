<Window x:Class="JiraWorkLogAssistant.Views.DashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:conv="clr-namespace:JiraWorkLogAssistant.Views.Converters"
        mc:Ignorable="d"
        Title="Dashboard"
        Width="600" Height="520"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip"
        MinWidth="480" MinHeight="420"
        Loaded="Window_Loaded">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <conv:StringToVisibilityConverter x:Key="StrToVis"/>
        <conv:InverseBoolToVisibilityConverter x:Key="InvBoolToVis"/>
        <conv:MinutesToTimeConverter x:Key="MinToTime"/>
    </Window.Resources>
    <Border Background="#1E1E2E" CornerRadius="10" BorderBrush="#374151" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0" Background="#26263A" Padding="16,10" CornerRadius="10,10,0,0"
                    MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid>
                    <TextBlock Text="Dashboard" FontSize="15" FontWeight="Bold" Foreground="#E2E8F0" VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Content="⟳ Refresh" Command="{Binding RefreshCommand}"
                                Style="{StaticResource SecondaryButtonStyle}" Padding="8,4" FontSize="11"/>
                        <Button Content="✕" Width="26" Height="26" Click="Close_Click" Margin="6,0,0,0"
                                Style="{StaticResource CloseButtonStyle}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Body -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="20,16">
                <StackPanel>
                    <!-- Stats row -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource CardStyle}" Margin="0,0,6,0">
                            <StackPanel>
                                <TextBlock Text="Tasks Today" Foreground="#64748B" FontSize="12"/>
                                <TextBlock Text="{Binding TodayTaskCount}" FontSize="28" FontWeight="Bold"
                                           Foreground="#7C3AED"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource CardStyle}" Grid.Column="1" Margin="3,0">
                            <StackPanel>
                                <TextBlock Text="Hours Logged" Foreground="#64748B" FontSize="12"/>
                                <TextBlock Text="{Binding TodayHoursLogged}" FontSize="28" FontWeight="Bold"
                                           Foreground="#22C55E"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource CardStyle}" Grid.Column="2" Margin="6,0,0,0">
                            <StackPanel>
                                <TextBlock Text="Pending Notes" Foreground="#64748B" FontSize="12"/>
                                <TextBlock Text="{Binding PendingWorkLogs}" FontSize="28" FontWeight="Bold"
                                           Foreground="#F59E0B"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- AI Tools -->
                    <TextBlock Text="AI Tools" Style="{StaticResource SectionTitleStyle}"/>
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Content="📊 Generate Daily Summary"
                                Command="{Binding GenerateDailySummaryCommand}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Margin="0,0,6,0" Padding="12,10" FontSize="13"/>
                        <Button Grid.Column="1" Content="🎤 Generate Standup"
                                Command="{Binding GenerateStandupCommand}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Margin="6,0,0,0" Padding="12,10" FontSize="13"/>
                    </Grid>

                    <ProgressBar IsIndeterminate="True" Height="2" Margin="0,0,0,12"
                                 Foreground="{StaticResource AccentBrush}" Background="Transparent" BorderThickness="0"
                                 Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"/>

                    <!-- Daily Summary -->
                    <Border Style="{StaticResource CardStyle}"
                            Visibility="{Binding DailySummary, Converter={StaticResource StrToVis}}">
                        <StackPanel>
                            <TextBlock Text="Daily Summary" Foreground="#64748B" FontSize="12" Margin="0,0,0,6"/>
                            <TextBox Text="{Binding DailySummary}" Style="{StaticResource ModernTextBoxStyle}"
                                     TextWrapping="Wrap" IsReadOnly="True" BorderThickness="0"
                                     Background="Transparent" FontSize="13" Foreground="#CBD5E1"/>
                        </StackPanel>
                    </Border>

                    <!-- Standup -->
                    <Border Style="{StaticResource CardStyle}"
                            Visibility="{Binding StandupText, Converter={StaticResource StrToVis}}">
                        <StackPanel>
                            <TextBlock Text="Standup" Foreground="#64748B" FontSize="12" Margin="0,0,0,6"/>
                            <TextBox Text="{Binding StandupText}" Style="{StaticResource ModernTextBoxStyle}"
                                     TextWrapping="Wrap" IsReadOnly="True" BorderThickness="0"
                                     Background="Transparent" FontSize="13" Foreground="#CBD5E1"/>
                        </StackPanel>
                    </Border>

                    <!-- Active Issues -->
                    <TextBlock Text="Active Issues" Style="{StaticResource SectionTitleStyle}"/>
                    <ItemsControl ItemsSource="{Binding ActiveIssues}" Margin="0,0,0,16">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#2A2A3E" CornerRadius="6" Padding="10,8" Margin="0,0,0,4"
                                        BorderBrush="{Binding BorderColor}" BorderThickness="3,0,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="80"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Key}" FontSize="11" FontWeight="Bold"
                                                   Foreground="{Binding BorderColor}" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Summary}" FontSize="12"
                                                   Foreground="#E2E8F0" TextTrimming="CharacterEllipsis"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Recent Logs -->
                    <TextBlock Text="Today's Work Logs" Style="{StaticResource SectionTitleStyle}"/>
                    <ItemsControl ItemsSource="{Binding RecentWorkLogs}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#2A2A3E" CornerRadius="6" Padding="10,8" Margin="0,0,0,4">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="80"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="80"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding JiraIssue.Key}" FontSize="11" FontWeight="Bold"
                                                   Foreground="{Binding JiraIssue.BorderColor}" VerticalAlignment="Top"/>
                                        <TextBlock Grid.Column="1" Text="{Binding GeneratedText}" FontSize="12"
                                                   Foreground="#CBD5E1" TextWrapping="Wrap" MaxHeight="60"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <StackPanel Grid.Column="2" Margin="10,0,0,0">
                                            <TextBlock Text="{Binding TimeSpentMinutes, Converter={StaticResource MinToTime}}"
                                                       FontSize="11" Foreground="#22C55E" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding Status}" FontSize="10" Foreground="#64748B"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>

